{
  "name": "UbuntuCare fictional hospital demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "UbuntuCare portal",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm ci && npm run demo:setup",
  "postStartCommand": "npm run demo:start",
  "remoteUser": "node"
}
