generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  patient
  doctor
  nurse
  admin
  paramedic
  billing
  insurer
  referring_doctor
}

enum Channel {
  Admissions
  Radiology
  Ward
  Theatre
  Billing
  Casualty
  Laboratory
  Transfers
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role
  unit         String
  organization String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  patient      PatientProfile?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PatientProfile {
  id                            String                     @id @default(cuid())
  userId                        String                     @unique
  facilityFileNumber            String
  fullName                      String
  saId                          String
  passportNumber                String
  citizenship                   String
  dateOfBirth                   DateTime
  gender                        String
  phone                         String
  email                         String
  language                      String
  preferredContactMethod        String
  province                      String
  city                          String
  address                       String
  postalCode                    String
  maritalStatus                 String
  occupation                    String
  employer                      String
  employerPhone                 String
  religion                      String
  homeClinic                    String
  arrivalMode                   String
  arrivalReason                 String
  broughtBy                     String
  referralSource                String
  referringDoctor               String
  transferredFrom               String
  transferReason                String
  medicalAidScheme              String
  medicalAidPlan                String
  medicalAidNumber              String
  membershipTier                String
  principalMemberName           String
  principalMemberNumber         String
  relationshipToPrincipalMember String
  nextOfKin                     String
  nextOfKinRelation             String
  nextOfKinPhone                String
  guardianName                  String
  guardianPhone                 String
  bloodType                     String
  allergies                     String
  currentMedication             String
  chronicConditions             String
  disabilitySupport             String
  pregnancyStatus               String
  visitPathway                  String
  triagePriority                String
  ward                          String
  bedNumber                     String
  interpreterRequired           Boolean                    @default(false)
  popiaConsent                  Boolean                    @default(false)
  consentTreatment              Boolean                    @default(false)
  consentDataSharing            Boolean                    @default(false)
  consentBilling                Boolean                    @default(false)
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  user                          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments                  Appointment[]
  scans                         ScanRecord[]
  vitalRecords                  VitalRecord[]
  medicationOrders              MedicationOrder[]
  labResults                    LabResult[]
  theatreCases                  TheatreCase[]
  transferRecords               TransferRecord[]
  documents                     DocumentRecord[]
  emailLogs                     EmailLog[]
  arrivals                      ArrivalRecord[]
  medicationAdministrations     MedicationAdministration[]
  encounters                    CareEncounter[]

  @@index([facilityFileNumber])
}

model Appointment {
  id            String         @id @default(cuid())
  reference     String         @unique
  patientId     String
  department    String
  clinician     String
  scheduledAt   DateTime
  type          String
  status        String
  location      String
  notes         String
  createdByRole Role
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model ScanRecord {
  id             String         @id @default(cuid())
  reference      String         @unique
  patientId      String
  title          String
  modality       String
  takenAt        DateTime
  department     String
  uploadedBy     String
  uploadedByRole Role
  notes          String
  previewData    String
  createdAt      DateTime       @default(now())
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model MessageRecord {
  id         String   @id @default(cuid())
  reference  String   @unique
  channel    Channel
  authorName String
  authorRole Role
  body       String
  createdAt  DateTime @default(now())
}

model ShiftTask {
  id         String   @id @default(cuid())
  reference  String   @unique
  title      String
  owner      String
  department String
  priority   String
  status     String
  eta        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model VitalRecord {
  id              String         @id @default(cuid())
  reference       String         @unique
  patientId       String
  recordedBy      String
  recordedByRole  Role
  recordedAt      DateTime
  systolic        Int
  diastolic       Int
  pulse           Int
  temperature     Float
  respiratoryRate Int
  spo2            Int
  glucose         String
  painScore       Int
  notes           String
  patient         PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
}

model MedicationOrder {
  id               String                     @id @default(cuid())
  reference        String                     @unique
  patientId        String
  prescribedBy     String
  prescribedByRole Role
  prescribedAt     DateTime                   @default(now())
  drugName         String
  dose             String
  route            String
  frequency        String
  indication       String
  startDate        DateTime
  endDate          DateTime?
  status           String
  patient          PatientProfile             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  administrations  MedicationAdministration[]

  @@index([patientId])
}

model MedicationAdministration {
  id                 String          @id @default(cuid())
  reference          String          @unique
  orderId            String
  patientId          String
  administeredBy     String
  administeredByRole Role
  administeredAt     DateTime        @default(now())
  status             String
  notes              String
  order              MedicationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient            PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([patientId])
}

model LabResult {
  id             String         @id @default(cuid())
  reference      String         @unique
  patientId      String
  provider       String
  testName       String
  specimen       String
  collectedAt    DateTime
  reportedAt     DateTime
  resultSummary  String
  abnormalFlag   String
  fileUrl        String
  uploadedBy     String
  uploadedByRole Role
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, reportedAt])
}

model TheatreCase {
  id            String         @id @default(cuid())
  reference     String         @unique
  patientId     String
  procedureName String
  specialty     String
  surgeon       String
  anaesthetist  String
  theatreRoom   String
  scheduledAt   DateTime
  urgency       String
  status        String
  notes         String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, scheduledAt])
}

model TransferRecord {
  id                  String         @id @default(cuid())
  reference           String         @unique
  patientId           String
  type                String
  sourceFacility      String
  destinationFacility String
  transportMode       String
  escortType          String
  reason              String
  requestedBy         String
  status              String
  eta                 String
  createdAt           DateTime       @default(now())
  patient             PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model DocumentRecord {
  id         String         @id @default(cuid())
  reference  String         @unique
  patientId  String
  category   String
  title      String
  body       String
  authorName String
  authorRole Role
  createdAt  DateTime       @default(now())
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model EmailLog {
  id        String         @id @default(cuid())
  reference String         @unique
  patientId String
  recipient String
  subject   String
  category  String
  sentBy    String
  status    String
  createdAt DateTime       @default(now())
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model ArrivalRecord {
  id            String         @id @default(cuid())
  reference     String         @unique
  patientId     String
  patientName   String
  arrivalMode   String
  source        String
  triageColor   String
  casualtyArea  String
  handoverNotes String
  broughtInAt   DateTime
  status        String
  createdBy     String
  createdAt     DateTime       @default(now())
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, broughtInAt])
}

model CareEncounter {
  id                   String                 @id @default(cuid())
  reference            String                 @unique
  patientId            String
  status               String                 @default("REQUESTED")
  version              Int                    @default(0)
  crewUserId           String?
  chiefComplaint       String
  location             String
  triage               String                 @default("Yellow")
  ward                 String                 @default("")
  bed                  String                 @default("")
  diagnosisCode        String                 @default("")
  clinicalSummary      String                 @default("")
  dischargeSummary     String                 @default("")
  createdById          String
  openedAt             DateTime               @default(now())
  closedAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  patient              PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  calls                CareCall[]
  notes                CareNote[]
  labOrders            CareLabOrder[]
  identityChecks       CareIdentityCheck[]
  eligibilityChecks    CareEligibilityCheck[]
  claims               CareClaim[]
  auditEvents          CareAuditEvent[]
  portalThreads        PortalThread[]
  portalDocuments      PortalDocument[]
  portalAppointments   PortalAppointment[]
  portalConcerns       PortalConcern[]
  portalRecordRequests PortalRecordRequest[]
  portalTasks          PortalTask[]
  portalNotifications  PortalNotification[]
  portalOutbox         PortalOutbox[]
  portalReminders      PortalReminder[]

  @@index([patientId, openedAt])
  @@index([crewUserId, status])
  @@index([status, updatedAt])
}

model CareCall {
  id                String        @id @default(cuid())
  encounterId       String
  direction         String
  purpose           String
  contactName       String
  phone             String
  summary           String
  status            String        @default("SIMULATED_COMPLETED")
  providerReference String
  createdById       String
  createdByName     String
  createdAt         DateTime      @default(now())
  encounter         CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
}

model CareNote {
  id          String        @id @default(cuid())
  encounterId String
  category    String
  body        String
  authorId    String
  authorName  String
  authorRole  Role
  createdAt   DateTime      @default(now())
  encounter   CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
}

model CareLabOrder {
  id            String        @id @default(cuid())
  reference     String        @unique
  encounterId   String
  testName      String
  specimen      String
  status        String        @default("REQUESTED")
  requestedById String
  resultSummary String        @default("")
  abnormalFlag  String        @default("")
  collectedAt   DateTime?
  reportedAt    DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime      @default(now())
  encounter     CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, status])
}

model CareIdentityCheck {
  id                String        @id @default(cuid())
  encounterId       String
  status            String
  providerReference String
  idLast4           String
  purpose           String
  consentRecordedAt DateTime
  checkedById       String
  createdAt         DateTime      @default(now())
  encounter         CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
}

model CareEligibilityCheck {
  id                     String        @id @default(cuid())
  encounterId            String
  scheme                 String
  memberNumberMasked     String
  status                 String
  authorizationStatus    String        @default("NOT_REQUESTED")
  authorizationReference String        @default("")
  providerReference      String
  coPaymentCents         Int           @default(0)
  checkedById            String
  createdAt              DateTime      @default(now())
  encounter              CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
}

model CareClaim {
  id                     String          @id @default(cuid())
  reference              String          @unique
  encounterId            String
  scheme                 String
  memberNumberMasked     String
  status                 String          @default("DRAFT")
  version                Int             @default(0)
  diagnosisCode          String
  authorizationReference String          @default("")
  totalCents             Int             @default(0)
  patientLiabilityCents  Int             @default(0)
  reviewNote             String          @default("")
  providerReference      String          @default("")
  snapshotJson           String          @default("{}")
  sharedWithInsurer      Boolean         @default(false)
  createdById            String
  submittedAt            DateTime?
  paidAt                 DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  encounter              CareEncounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  lineItems              CareClaimLine[]

  @@index([encounterId, createdAt])
  @@index([scheme, sharedWithInsurer, status])
}

model CareClaimLine {
  id             String    @id @default(cuid())
  claimId        String
  serviceCode    String
  description    String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime  @default(now())
  claim          CareClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model CareAuditEvent {
  id          String         @id @default(cuid())
  encounterId String?
  actorId     String
  actorName   String
  actorRole   Role
  action      String
  details     String         @default("")
  createdAt   DateTime       @default(now())
  encounter   CareEncounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
}

model PortalThread {
  id              String               @id @default(cuid())
  encounterId     String
  type            String
  subject         String
  claimId         String?
  recordRequestId String?
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  encounter       CareEncounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  members         PortalThreadMember[]
  messages        PortalMessage[]

  @@index([encounterId, updatedAt])
  @@index([claimId])
  @@index([recordRequestId])
}

model PortalThreadMember {
  id         String       @id @default(cuid())
  threadId   String
  userId     String
  lastReadAt DateTime?
  thread     PortalThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, threadId])
}

model PortalMessage {
  id                String       @id @default(cuid())
  threadId          String
  authorId          String
  authorName        String
  authorRole        Role
  body              String
  attachmentIdsJson String       @default("[]")
  createdAt         DateTime     @default(now())
  thread            PortalThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model PortalDocument {
  id              String                  @id @default(cuid())
  encounterId     String
  title           String
  kind            String
  visibility      String
  claimId         String?
  recordRequestId String?
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  encounter       CareEncounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  versions        PortalDocumentVersion[]

  @@index([encounterId, visibility, updatedAt])
  @@index([claimId])
  @@index([recordRequestId])
}

model PortalDocumentVersion {
  id                       String            @id @default(cuid())
  documentId               String
  version                  Int
  title                    String
  body                     String
  contentHash              String
  status                   String            @default("DRAFT")
  requiresPatientSignature Boolean           @default(false)
  createdById              String
  publishedAt              DateTime?
  createdAt                DateTime          @default(now())
  document                 PortalDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  files                    PortalFile[]
  signatures               PortalSignature[]

  @@unique([documentId, version])
  @@index([documentId, status])
}

model PortalFile {
  id           String                @id @default(cuid())
  versionId    String
  originalName String
  mimeType     String
  size         Int
  sha256       String
  bytes        Bytes
  uploadedById String
  createdAt    DateTime              @default(now())
  version      PortalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model PortalSignature {
  id          String                @id @default(cuid())
  versionId   String
  signerId    String
  signerName  String
  signerRole  Role
  type        String                @default("TYPED_ACKNOWLEDGEMENT")
  contentHash String
  statement   String
  createdAt   DateTime              @default(now())
  version     PortalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, signerId])
  @@index([signerId, createdAt])
}

model PortalAppointment {
  id                  String           @id @default(cuid())
  reference           String           @unique
  encounterId         String
  clinicianId         String
  title               String
  department          String
  startsAt            DateTime
  endsAt              DateTime
  mode                String
  status              String           @default("REQUESTED")
  version             Int              @default(0)
  createdById         String
  patientInstructions String           @default("")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  encounter           CareEncounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  reminders           PortalReminder[]
  videoRoom           PortalVideoRoom?

  @@index([encounterId, startsAt])
  @@index([clinicianId, status, startsAt, endsAt])
}

model PortalReminder {
  id            String             @id @default(cuid())
  appointmentId String?
  encounterId   String
  userId        String
  channel       String
  dueAt         DateTime
  status        String             @default("PENDING")
  dedupeKey     String             @unique
  deliveredAt   DateTime?
  createdAt     DateTime           @default(now())
  appointment   PortalAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  encounter     CareEncounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([userId, dueAt])
  @@index([appointmentId])
  @@index([encounterId])
}

model PortalNotification {
  id          String        @id @default(cuid())
  encounterId String
  userId      String
  title       String
  body        String
  kind        String
  link        String        @default("/connect")
  dedupeKey   String        @unique
  readAt      DateTime?
  createdAt   DateTime      @default(now())
  encounter   CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([encounterId, createdAt])
}

model PortalOutbox {
  id              String        @id @default(cuid())
  encounterId     String
  recipientUserId String?
  recipientEmail  String
  subject         String
  body            String
  category        String
  status          String        @default("QUEUED_SIMULATED")
  dedupeKey       String        @unique
  createdById     String
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  encounter       CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([status, createdAt])
}

model PortalConcern {
  id             String                @id @default(cuid())
  encounterId    String
  category       String
  body           String
  urgency        String                @default("NORMAL")
  status         String                @default("OPEN")
  version        Int                   @default(0)
  createdById    String
  assignedUserId String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  encounter      CareEncounter         @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  updates        PortalConcernUpdate[]

  @@index([encounterId, createdAt])
  @@index([assignedUserId, status, updatedAt])
}

model PortalConcernUpdate {
  id         String        @id @default(cuid())
  concernId  String
  authorId   String
  authorName String
  authorRole Role
  body       String
  status     String
  createdAt  DateTime      @default(now())
  concern    PortalConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@index([concernId, createdAt])
}

model PortalRecordRequest {
  id                 String        @id @default(cuid())
  reference          String        @unique
  encounterId        String
  providerName       String
  providerEmail      String
  providerUserId     String?
  purpose            String
  scope              String
  consentRecordedAt  DateTime
  expiresAt          DateTime
  status             String        @default("REQUESTED")
  version            Int           @default(0)
  createdById        String
  assignedStaffId    String?
  fulfilledVersionId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  encounter          CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
  @@index([providerUserId, status, expiresAt])
  @@index([assignedStaffId, status])
}

model PortalTask {
  id             String        @id @default(cuid())
  encounterId    String
  department     String
  title          String
  priority       String        @default("NORMAL")
  status         String        @default("OPEN")
  version        Int           @default(0)
  assignedUserId String
  createdById    String
  dueAt          DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  encounter      CareEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, department, status])
  @@index([assignedUserId, status, dueAt])
}

model PortalVideoRoom {
  id            String                   @id @default(cuid())
  appointmentId String                   @unique
  status        String                   @default("WAITING")
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime                 @default(now())
  appointment   PortalAppointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  participants  PortalVideoParticipant[]
  signals       PortalVideoSignal[]
}

model PortalVideoParticipant {
  id                String          @id @default(cuid())
  roomId            String
  userId            String
  consentRecordedAt DateTime
  joinedAt          DateTime        @default(now())
  room              PortalVideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model PortalVideoSignal {
  id        String          @id @default(cuid())
  roomId    String
  senderId  String
  kind      String
  payload   String
  expiresAt DateTime
  createdAt DateTime        @default(now())
  room      PortalVideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, expiresAt, createdAt])
  @@index([expiresAt])
}
