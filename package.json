{
  "name": "ubuntu-care-sa-demo",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "node scripts/prepare-sqlite.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/prepare-sqlite.mjs && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "reminders:run": "tsx scripts/reminder-worker.ts --once",
    "reminders:worker": "tsx scripts/reminder-worker.ts --watch",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo:start": "node scripts/demo-start.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "next": "15.5.29",
    "pdf-lib": "^1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "prisma": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.8.3"
  }
}
